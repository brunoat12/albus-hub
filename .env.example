# Aplicação
APP_ENV=local
APP_NAME=albus-hub
CLOUD_PROVIDER=local
LOG_LEVEL=INFO

# Dados
DATA_RAW_PATH=data/raw
DATA_REJECTED_PATH=data/rejected
DATA_BRONZE_PATH=data/bronze
DATA_SILVER_PATH=data/silver
DATA_GOLD_PATH=data/gold
DATA_SAMPLE_PATH=data/sample

# Modelos e artefatos
MODEL_VOLUME_PATH=models/volume
MODEL_RISK_PATH=models/risk
ARTIFACT_PATH=artifacts

# PostgreSQL local
POSTGRES_USER=albus
POSTGRES_PASSWORD=albus_local
POSTGRES_DB=albus_hub
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://albus:albus_local@localhost:5432/albus_hub

# RabbitMQ local
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=albus
RABBITMQ_PASSWORD=albus_local
RABBITMQ_QUEUE=albus_alerts
RABBITMQ_URL=amqp://albus:albus_local@localhost:5672/

# Camada Gold de volume diário
LOCAWEB_GOLD_DAILY_VOLUME_FILE=data/gold/daily_incident_volume.parquet
LOCAWEB_GOLD_DAILY_BREAKDOWN_FILE=data/gold/daily_incident_breakdown.parquet
LOCAWEB_GOLD_DAILY_VOLUME_REPORT=artifacts/quality/locaweb_daily_volume_report.json

LOCAWEB_TEMPORAL_EDA_OUTPUT_DIR=artifacts/eda/locaweb
LOCAWEB_TEMPORAL_EDA_REPORT=artifacts/eda/locaweb/temporal_eda_report.json
# Backup e recuperação
DATA_BACKUP_PATH=data/backups
BACKUP_RETENTION_DAYS=30
BACKUP_FULL_INTERVAL_DAYS=7

# Artefatos de inferência
LOCAWEB_VOLUME_PREDICTIONS_FILE=data/gold/volume_predictions.parquet
LOCAWEB_RISK_SCORES_FILE=data/gold/risk_scores.parquet

# Interface web
STREAMLIT_PORT=8501

# Azure Database for MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=albus
MYSQL_PASSWORD=albus_local
MYSQL_DB=albus_hub
MYSQL_CONNECT_TIMEOUT=10

# Certificado CA para conexões TLS em ambiente cloud.
# MYSQL_SSL_CA=/app/certs/DigiCertGlobalRootG2.crt.pem

# Azure Database for MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=albus
MYSQL_PASSWORD=albus_local
MYSQL_DB=albus_hub
MYSQL_CONNECT_TIMEOUT=10

# Certificado CA para conexões TLS em ambiente cloud.
# MYSQL_SSL_CA=/app/certs/DigiCertGlobalRootG2.crt.pem

# Azure Database for MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=albus
MYSQL_PASSWORD=albus_local
MYSQL_DB=albus_hub
MYSQL_CONNECT_TIMEOUT=10

# Certificado CA para conexões TLS em ambiente cloud.
# MYSQL_SSL_CA=/app/certs/DigiCertGlobalRootG2.crt.pem
